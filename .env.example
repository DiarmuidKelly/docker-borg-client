# Borg Repository Configuration
# Required: SSH URL to your Borg repository
BORG_REPO=ssh://user@backup-server.example.com:22/~/backups/my-backup

# Required: Repository encryption passphrase (one of the three options below).
# IMPORTANT: Keep this secure! Without it, you cannot restore your backups.
#
# Option 1 - passphrase directly in this var (simplest):
BORG_PASSPHRASE=your-strong-passphrase-here
#
# Option 2 - read the passphrase from a mounted file (e.g. on an encrypted
# dataset) so it never lives in the orchestrator's stored config:
# BORG_PASSPHRASE_FILE=/run/secrets/passphrase
#
# Option 3 - borg-native; keeps the passphrase out of the environment entirely:
# BORG_PASSCOMMAND=cat /run/secrets/passphrase
#
# See the "Protecting the Passphrase" section of the README for the TrueNAS
# encrypted-dataset threat model and which option to choose.

# Required: Colon-separated paths to backup (container paths)
# These correspond to the mounted volumes in docker-compose.yml
BACKUP_PATHS=/data/backup1
# Explicitly mark paths you do not want backed up.
BACKUP_EXCLUDES=/data/backup1/cache

# Optional: Source directories on host to backup
BACKUP_SOURCE_1=/path/to/your/data
# BACKUP_SOURCE_2=/path/to/more/data

# Optional: Cron schedule for backups (default: Sunday at 2am)
# Format: minute hour day-of-month month day-of-week
# Examples:
#   0 2 * * 0     - Every Sunday at 2am (default)
#   0 3 * * *     - Every day at 3am
#   0 2 * * 1-5   - Weekdays at 2am
#   0 */6 * * *   - Every 6 hours
CRON_SCHEDULE=0 2 * * 0

# Optional: Run backup immediately on container start (default: false)
RUN_ON_START=false

# Optional: Prune retention policy (default values shown)
PRUNE_KEEP_DAILY=7
PRUNE_KEEP_WEEKLY=4
PRUNE_KEEP_MONTHLY=6

# Optional: Timezone for cron jobs (default: UTC)
TZ=Europe/London

# =============================================================================
# Job History (Optional)
# =============================================================================

# Every job records its outcome to a persistent file on the /borg/config volume,
# so a failure survives log rotation, a redeploy and an app restart. The startup
# preflight reads it back and prints a status board.
#
# This container does NOT push alerts anywhere. It records what happened; you
# have to look. The TrueNAS notification transport was removed because it never
# worked - alert.oneshot_create returns an ID but the alert never surfaces in
# the UI or triggers any service (issue #33).
#
# Check health at any time with:
#   /scripts/preflight.sh      - most recent archive, passphrase, job history
#   /scripts/restore.sh list   - every archive with its date

# HISTORY_FILE=/borg/config/history.log

# Rolling cap, oldest lines dropped. ~6 months at a daily backup plus checks.
# HISTORY_MAX_LINES=500

# =============================================================================
# Recovery: Restore Drills and Preflight (Optional)
# =============================================================================

# A passing `borg check` proves the repository is intact; it does not prove you
# can get your files back. A drill restores a sample of real files and compares
# them to the live source byte-for-byte.
#
# Drills are read-only and never break a repository lock: if a backup is
# running, the drill skips that run instead of disrupting it.

# Enable scheduled restore drills (default: false)
RESTORE_DRILL_ENABLED=false

# Drill schedule (cron format). Quarterly is a sensible default.
# RESTORE_DRILL_CRON_SCHEDULE=0 4 1 1,4,7,10 *

# How many files to restore per drill (default: 3)
# The sample rotates by day so successive drills cover different files.
# RESTORE_DRILL_SAMPLE_COUNT=3

# Drill these exact archive paths instead of a rotating sample. Use this to pin
# drills to the files that matter most. Paths have NO leading slash: a source
# path of /data/db appears in the archive as data/db.
# RESTORE_DRILL_PATHS=data/db/nightly-dump.sql:data/config/settings.yml

# Skip files larger than this when sampling (default: 104857600 = 100 MB)
# RESTORE_DRILL_MAX_FILE_BYTES=104857600

# Archive to drill (default: latest)
# RESTORE_DRILL_ARCHIVE=latest

# Scratch directory for drills, and whether to keep restored files afterwards.
# Each run works in its own subdirectory, so anything else in this directory is
# left alone. Must be outside BACKUP_PATHS - the drill refuses to start
# otherwise, because it deletes its own working directory.
# RESTORE_DRILL_TARGET=/tmp/restore-drill
# RESTORE_DRILL_KEEP=false

# Seconds to wait for the repository lock before skipping the drill. Kept short
# deliberately: a drill gains nothing by waiting, and issue #42 was a long
# blocking lock wait that outlived the container.
# RESTORE_DRILL_LOCK_WAIT=60

# Where a successful drill is recorded, and how stale it may get before the
# startup preflight warns. This is what stops a drill that keeps skipping from
# going unnoticed behind a quarterly schedule.
# RESTORE_DRILL_STATE_FILE=/borg/config/last-restore-drill
# RESTORE_DRILL_MAX_AGE_DAYS=100

# Startup recovery-readiness report. Verifies the repository is reachable AND
# that the passphrase actually decrypts the repository key.
# PREFLIGHT_ENABLED=true

# Refuse to start when preflight finds a problem (e.g. a wrong passphrase).
# Default false: a transient network fault should not crash-loop the container.
# PREFLIGHT_STRICT=false

# =============================================================================
# Backup Time Window and Rate Limiting (Optional)
# =============================================================================

# Restrict backups to specific time windows (24-hour format HH:MM)
# Leave empty to allow backups at any time
# Examples:
#   - Night window:     BACKUP_WINDOW_START=01:00, BACKUP_WINDOW_END=07:00
#   - Overnight window: BACKUP_WINDOW_START=22:00, BACKUP_WINDOW_END=06:00
#   - Day window:       BACKUP_WINDOW_START=09:00, BACKUP_WINDOW_END=17:00
# BACKUP_WINDOW_START=01:00
# BACKUP_WINDOW_END=07:00

# Rate limit INSIDE the backup window (in Mbps)
# -1  = Unlimited bandwidth (burst speeds, default)
#  0  = Not applicable for inside window (would prevent backups)
# >0  = Limit in Mbps (e.g., 40 = 40 Mbps)
# Default: -1 (unlimited)
# BACKUP_RATE_LIMIT_IN_WINDOW=-1

# Rate limit OUTSIDE the backup window (in Mbps)
# -1  = Unlimited bandwidth (no time restriction)
#  0  = Stopped (no backup outside window, recommended)
# >0  = Limit in Mbps (e.g., 5 = 5 Mbps trickle during day)
# Default: -1 (unlimited)
# BACKUP_RATE_LIMIT_OUT_WINDOW=0

# Example configurations:
#
# 1. Large initial backup on limited connection (40 Mbps):
#    BACKUP_WINDOW_START=01:00
#    BACKUP_WINDOW_END=07:00
#    BACKUP_RATE_LIMIT_IN_WINDOW=-1   # Unlimited overnight
#    BACKUP_RATE_LIMIT_OUT_WINDOW=0   # Stopped during day
#
# 2. Continuous backup with daytime throttle:
#    BACKUP_WINDOW_START=22:00
#    BACKUP_WINDOW_END=08:00
#    BACKUP_RATE_LIMIT_IN_WINDOW=-1   # Unlimited overnight
#    BACKUP_RATE_LIMIT_OUT_WINDOW=5   # 5 Mbps trickle during day
#
# 3. No time restriction (default behavior):
#    # Leave BACKUP_WINDOW_START and BACKUP_WINDOW_END empty
#    BACKUP_RATE_LIMIT_IN_WINDOW=-1
#    BACKUP_RATE_LIMIT_OUT_WINDOW=-1
